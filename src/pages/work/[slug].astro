---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icons from '../../components/Icons.astro';
import Cover from '../../components/Cover.astro';
import { kinds, site } from '../../data/site';

export async function getStaticPaths() {
  const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return all.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: all[(i - 1 + all.length) % all.length], next: all[(i + 1) % all.length], total: all.length },
  }));
}
const { project, prev, next, total } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const canEmbed = d.embed && d.link;
---
<Base title={`${d.title} — Spaceynyc`} description={d.blurb} image={d.image ?? '/assets/og.jpg'} bodyClass="project-page">
  <article class="project" style={`--project-color:${d.color}`}>
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/#work"><Icons name="arrow-left" /> Work</a>
        <span class="mono">{d.number} / {String(total).padStart(2, '0')}</span>
      </nav>
      <header class="project-head">
        <p class="kicker">{kinds[d.kind]} <span class="mono">/ {d.year}</span></p>
        <h1 class="display chrome-text">{d.title}</h1>
        <p class="lead">{d.blurb}</p>
        <div class="actions">
          {d.link ? (
            <a class="pill" href={d.link} target="_blank" rel="noopener noreferrer">{project.id === 'aeroeden' ? 'Explore AEROEDEN' : 'Launch live'} <Icons name="arrow-up-right" /></a>
          ) : (
            <a class="pill" href={`mailto:${site.email}?subject=${encodeURIComponent(`Tell me about ${d.title}`)}`}>Ask about this project <Icons name="arrow-up-right" /></a>
          )}
          {d.github && <a class="pill ghost" href={d.github} target="_blank" rel="noopener noreferrer"><Icons name="github" /> Source</a>}
        </div>
      </header>

      <figure class="media" data-media>
        <div class="media-frame">
          <Cover project={project} eager class="media-cover" />
          {canEmbed && (
            <div class="embed" data-embed hidden>
              <iframe title={`${d.title} live demo`} loading="lazy" allow="autoplay; fullscreen; xr-spatial-tracking" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          )}
        </div>
        {canEmbed && (
          <figcaption class="media-bar">
            <button class="pill small" type="button" data-load-demo data-src={d.link}>Load live demo <span class="spark" aria-hidden="true">✦</span></button>
            <a class="open-new" href={d.link} target="_blank" rel="noopener noreferrer">Open in a new tab <Icons name="arrow-up-right" /></a>
          </figcaption>
        )}
      </figure>

      <div class="body-grid">
        <aside class="meta">
          <div><h2 class="kicker">Built with</h2><ul class="tags">{d.tech.map((t) => <li>{t}</li>)}</ul></div>
          <div><h2 class="kicker">Kind</h2><p>{kinds[d.kind]}</p></div>
          <div><h2 class="kicker">Year</h2><p class="mono">{d.year}</p></div>
          {d.link && <div><h2 class="kicker">Live</h2><p><a class="meta-link" href={d.link} target="_blank" rel="noopener noreferrer">{new URL(d.link).host}</a></p></div>}
        </aside>
        <div class="prose"><Content /></div>
      </div>

      <nav class="pager" aria-label="More work">
        <a class="pager-link" href={`/work/${prev.id}/`} rel="prev"><span class="kicker">Previous</span><span class="display">{prev.data.title}</span></a>
        <a class="pager-link next" href={`/work/${next.id}/`} rel="next"><span class="kicker">Next</span><span class="display">{next.data.title}</span></a>
      </nav>
    </div>
  </article>
</Base>

<style>
  .project { padding-block: clamp(24px, 4vw, 48px) 0; }
  .crumbs { display: flex; justify-content: space-between; align-items: center; font-size: var(--t-xs); letter-spacing: .18em; text-transform: uppercase; color: var(--muted); }
  .crumbs a { display: inline-flex; align-items: center; gap: 8px; } .crumbs svg { width: 16px; height: 16px; } .crumbs a:hover { color: var(--lavender); }
  .project-head { display: grid; gap: 24px; justify-items: start; padding-block: clamp(40px, 6vw, 88px) clamp(32px, 4vw, 56px); max-width: 980px; }
  .project-head h1 { font-size: var(--t-3xl); overflow-wrap: anywhere; }
  .lead { font-size: var(--t-lg); color: var(--ink-2); line-height: 1.6; max-width: 62ch; }
  .actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .actions svg { width: 18px; height: 18px; }
  .media { margin: 0; display: grid; gap: 14px; }
  .media-frame { position: relative; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; background: #090c12; aspect-ratio: 16 / 9; box-shadow: 0 40px 100px -40px color-mix(in srgb, var(--project-color) 40%, transparent); }
  .media-frame :global(img), .media-frame :global(.cover) { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .embed { position: absolute; inset: 0; background: #000; }
  .embed iframe { width: 100%; height: 100%; border: 0; }
  .media-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .open-new { font-size: var(--t-xs); letter-spacing: .16em; text-transform: uppercase; color: var(--muted); display: inline-flex; align-items: center; gap: 8px; }
  .open-new svg { width: 14px; height: 14px; } .open-new:hover { color: var(--lavender); }
  .body-grid { display: grid; grid-template-columns: 260px 1fr; gap: clamp(32px, 6vw, 96px); padding-block: clamp(48px, 7vw, 100px); }
  .meta { display: grid; gap: 28px; align-content: start; position: sticky; top: calc(var(--header-h) + 24px); }
  .meta h2 { margin-bottom: 10px; font-weight: 400; }
  .meta p { color: var(--ink-2); }
  .meta-link { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--line-2); } .meta-link:hover { color: var(--lavender); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font-size: var(--t-xs); letter-spacing: .1em; text-transform: uppercase; padding: 8px 12px; border: 1px solid var(--line-2); border-radius: 999px; color: var(--ink-2); }
  .prose { font-size: var(--t-lg); line-height: 1.7; color: var(--ink-2); max-width: 64ch; }
  .prose :global(p + p) { margin-top: 1.2em; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
  .pager-link { display: grid; gap: 10px; padding: 36px 0; transition: color .25s; }
  .pager-link .display { font-size: clamp(1.2rem, 1rem + 1.4vw, 2rem); color: var(--ink); }
  .pager-link.next { text-align: right; justify-items: end; border-left: 1px solid var(--line); }
  .pager-link.next .kicker { flex-direction: row-reverse; }
  .pager-link:hover .display { color: var(--lavender); }
  @media (max-width: 900px) { .body-grid { grid-template-columns: 1fr; } .meta { position: static; grid-template-columns: repeat(2, 1fr); } .pager { grid-template-columns: 1fr; } .pager-link.next { border-left: 0; border-top: 1px solid var(--line); } }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-load-demo]');
  const embed = document.querySelector<HTMLElement>('[data-embed]');
  const frame = embed?.querySelector('iframe');
  btn?.addEventListener('click', () => {
    if (!embed || !frame) return;
    frame.src = btn.dataset.src ?? '';
    embed.hidden = false;
    btn.textContent = 'Live demo running';
    btn.disabled = true;
  });
</script>
