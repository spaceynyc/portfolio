---
import HeroSculpture from '../islands/HeroSculpture';
import Lettering from './Lettering.astro';
import Icons from './Icons.astro';
import { site } from '../data/site';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="kicker reveal">Creative technologist <span class="spark">×</span> NYC</p>
      <h1 id="hero-title" class="hero-title">
        <span class="sr-only">Ideas in orbit</span>
        <Lettering name="hero" />
      </h1>
      <p class="intro">{site.person} — aka <strong>{site.alias}</strong>. I turn bold ideas into intelligent tools, immersive worlds, and digital experiences that feel a little ahead of their time.</p>
      <div class="hero-actions">
        <a class="pill" href="#work">View my work <Icons name="arrow" /></a>
        <a class="hero-lab" href="#lab">Enter the lab <span class="spark" aria-hidden="true">✦</span></a>
      </div>
    </div>
    <div class="hero-visual">
      <HeroSculpture client:idle />
      <p class="hero-motto" aria-hidden="true">A<br />brighter<br />tomorrow.<br />together.</p>
    </div>
  </div>
  <div class="hero-glow" aria-hidden="true"></div>
  <a class="scroll-cue" href="#work" aria-label="Scroll to work"><span></span></a>
</section>

<style>
  .hero { position: relative; min-height: calc(100svh - var(--header-h)); display: grid; align-items: center; overflow: clip; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; gap: clamp(24px, 4vw, 64px); padding-block: clamp(32px, 6vw, 80px); position: relative; z-index: 1; }
  .hero-copy { min-width: 0; display: grid; gap: clamp(20px, 2.6vw, 36px); justify-items: start; }
  .hero-title { width: 100%; max-width: 640px; filter: drop-shadow(0 6px 18px #00000088); }
  .hero-title :global(svg) { overflow: visible; }
  .intro { font-size: var(--t-lg); line-height: 1.55; color: var(--ink-2); max-width: 46ch; }
  .intro strong { color: #fff; font-weight: 500; }
  .hero-actions { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; }
  .hero-lab { font-size: var(--t-xs); letter-spacing: .22em; text-transform: uppercase; color: var(--muted); display: inline-flex; gap: 10px; align-items: center; transition: color .25s; }
  .hero-lab:hover { color: var(--lavender); }
  .hero-visual { position: relative; aspect-ratio: 1 / 0.86; min-height: 380px; }
  .hero-visual :global(.hero-canvas) { position: absolute; inset: -12% -18% -10% -6%; }
  .hero-visual :global(.hero-canvas canvas) { width: 100% !important; height: 100% !important; }
  .hero-visual :global(.hero-canvas[data-ready="true"]) { animation: fade-in 1.2s var(--ease-out) both; }
  .hero-visual :global(.hero-poster) { position: absolute; inset: 0; background: url('/assets/reference.png') right top / 179% 201% no-repeat; mask: url('/assets/hero-mobile-mask.svg') center / 100% 100% no-repeat; }
  .hero-motto { position: absolute; right: 0; bottom: 8%; font-size: var(--t-xs); letter-spacing: .3em; text-transform: uppercase; line-height: 1.7; text-align: right; color: var(--muted); }
  .hero-glow { position: absolute; inset: auto -10% -30% auto; width: 60vw; height: 60vw; max-width: 900px; max-height: 900px; background: radial-gradient(closest-side, #8b5dff22, transparent 70%); pointer-events: none; z-index: 0; }
  .scroll-cue { position: absolute; left: 50%; bottom: 20px; width: 22px; height: 36px; border: 1px solid var(--line-2); border-radius: 12px; transform: translateX(-50%); display: none; }
  .scroll-cue span { position: absolute; left: 50%; top: 6px; width: 2px; height: 8px; background: var(--lavender); border-radius: 2px; transform: translateX(-50%); animation: cue 1.8s ease-in-out infinite; }
  @keyframes cue { 0%, 100% { transform: translate(-50%, 0); opacity: 1; } 60% { transform: translate(-50%, 12px); opacity: 0; } }
  @keyframes fade-in { from { opacity: 0; transform: scale(.96); } to { opacity: 1; transform: none; } }
  @media (min-width: 1100px) { .scroll-cue { display: block; } }
  @media (max-width: 900px) {
    .hero { min-height: auto; }
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .hero-visual { aspect-ratio: 1 / 0.8; min-height: 300px; max-width: 640px; width: 100%; margin-inline: auto; }
    .hero-visual :global(.hero-canvas) { inset: -8% -10%; }
    .hero-motto { bottom: -8px; font-size: .55rem; }
  }
  @media (prefers-reduced-motion: reduce) { .scroll-cue span { animation: none; } }
</style>
