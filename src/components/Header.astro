---
import { nav } from '../data/site';
---
<header class="site-header" data-header>
  <div class="container header-row">
    <a class="brand" href="/" aria-label="Spaceynyc home">
      <img src="/assets/logo.png" alt="Spaceynyc" width="1774" height="887" fetchpriority="high" />
    </a>
    <nav class="main-nav" aria-label="Main navigation" id="main-nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="pill small create" href="/#contact">Let's create <span class="spark" aria-hidden="true">✦</span></a>
    </nav>
    <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="main-nav" data-menu>
      <span></span><span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50; height: var(--header-h);
    border-bottom: 1px solid transparent; transition: border-color .3s, background .3s, backdrop-filter .3s;
  }
  .site-header[data-scrolled] { border-color: var(--line); background: #05060799; backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .header-row { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand img { width: 168px; height: auto; transform: scaleY(.78); transform-origin: left center; filter: drop-shadow(0 0 10px #8b5dff33); }
  .main-nav { display: flex; align-items: center; gap: clamp(20px, 3vw, 44px); }
  .main-nav a:not(.pill) { font-size: var(--t-sm); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); position: relative; padding: 6px 0; }
  .main-nav a:not(.pill)::after { content: ''; position: absolute; left: 0; right: 100%; bottom: 0; height: 1px; background: var(--lavender); transition: right .3s var(--ease-out); }
  .main-nav a:not(.pill):hover::after { right: 0; }
  .create { margin-left: 8px; }
  .menu-toggle { display: none; width: 44px; height: 44px; flex-direction: column; justify-content: center; align-items: center; gap: 7px; }
  .menu-toggle span { display: block; width: 26px; height: 1.5px; background: var(--ink); transition: transform .3s var(--ease-out), opacity .3s; }
  @media (max-width: 820px) {
    .menu-toggle { display: flex; }
    .brand img { width: 140px; }
    .main-nav {
      position: fixed; inset: var(--header-h) 0 0 0; background: #050607f2; backdrop-filter: blur(20px);
      flex-direction: column; align-items: flex-start; justify-content: flex-start; gap: 8px;
      padding: 32px var(--gutter); transform: translateY(-8px); opacity: 0; pointer-events: none; transition: opacity .3s, transform .3s var(--ease-out);
    }
    .main-nav a:not(.pill) { font-family: var(--font-display); font-size: clamp(2rem, 9vw, 3rem); letter-spacing: .02em; padding: 10px 0; color: var(--ink); }
    .create { margin: 24px 0 0; }
    .site-header[data-open] .main-nav { opacity: 1; transform: none; pointer-events: auto; }
    .site-header[data-open] .menu-toggle span:first-child { transform: translateY(4.25px) rotate(45deg); }
    .site-header[data-open] .menu-toggle span:last-child { transform: translateY(-4.25px) rotate(-45deg); }
    .site-header[data-open] { background: var(--bg); border-color: var(--line); }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu]')!;
  const setOpen = (open: boolean) => {
    header.toggleAttribute('data-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
  header.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  const onScroll = () => header.toggleAttribute('data-scrolled', scrollY > 8);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
</script>
